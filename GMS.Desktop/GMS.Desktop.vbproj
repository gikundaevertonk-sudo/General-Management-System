<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>GMS.Desktop</RootNamespace>
    <AssemblyName>GMS.Desktop</AssemblyName>
    <StartupObject>GMS.Desktop.Program</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>Empty</MyType>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <NoWarn>BC42353;WFO1000</NoWarn>
    <UserSecretsId>89471431-978a-4a82-9e1d-bac6bbddcd0e</UserSecretsId>
    <ApplicationIcon>..\assets\gms.ico</ApplicationIcon>
    <Version>1.0.4.0</Version>
    <InformationalVersion>1.0.4</InformationalVersion>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>

    <!-- Publishing configuration for standalone deployment -->
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- ApplicationIcon only writes the Win32 resource the shell reads. Form.Icon
       ignores that and falls back to the built-in WinForms icon, so the same file
       is embedded for UiKit.AppIcon to hand to each window. -->
  <ItemGroup>
    <EmbeddedResource Include="..\assets\gms.ico" LogicalName="gms.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.4" />
  </ItemGroup>

  <!-- Ships next to the .exe so an installed copy has somewhere to put its connection
       string. User-secrets are a developer-machine store and are never published. -->
  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GMS.Core\GMS.Core.vbproj" />
  </ItemGroup>

  <!-- Dialog forms that open in the Windows Forms designer (code-behind + *.Designer.vb). -->
  <ItemGroup>
    <Compile Update="Forms\LoginForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\LoginForm.Designer.vb"><DependentUpon>LoginForm.vb</DependentUpon></Compile>
    <Compile Update="Forms\ChangePasswordForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\ChangePasswordForm.Designer.vb"><DependentUpon>ChangePasswordForm.vb</DependentUpon></Compile>
    <Compile Update="Forms\ProductEditForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\ProductEditForm.Designer.vb"><DependentUpon>ProductEditForm.vb</DependentUpon></Compile>
    <Compile Update="Forms\UserEditForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\UserEditForm.Designer.vb"><DependentUpon>UserEditForm.vb</DependentUpon></Compile>
    <Compile Update="Forms\SetPasswordForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\SetPasswordForm.Designer.vb"><DependentUpon>SetPasswordForm.vb</DependentUpon></Compile>
    <Compile Update="Forms\StockAdjustForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\StockAdjustForm.Designer.vb"><DependentUpon>StockAdjustForm.vb</DependentUpon></Compile>
    <Compile Update="Forms\TransactionEditForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\TransactionEditForm.Designer.vb"><DependentUpon>TransactionEditForm.vb</DependentUpon></Compile>
    <Compile Update="Forms\CustomerEditForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\CustomerEditForm.Designer.vb"><DependentUpon>CustomerEditForm.vb</DependentUpon></Compile>
    <Compile Update="Forms\SupplierEditForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\SupplierEditForm.Designer.vb"><DependentUpon>SupplierEditForm.vb</DependentUpon></Compile>
    <Compile Update="Forms\CategoryEditForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\CategoryEditForm.Designer.vb"><DependentUpon>CategoryEditForm.vb</DependentUpon></Compile>
    <Compile Update="Forms\ShopEditForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\ShopEditForm.Designer.vb"><DependentUpon>ShopEditForm.vb</DependentUpon></Compile>
    <Compile Update="Forms\StockAllocateForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\StockAllocateForm.Designer.vb"><DependentUpon>StockAllocateForm.vb</DependentUpon></Compile>
  </ItemGroup>

</Project>
