<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GMS.Web</RootNamespace>
    <UserSecretsId>04c4188b-7ea6-48e9-a4b7-0a65afd69862</UserSecretsId>
    <Version>1.0.2.0</Version>
    <InformationalVersion>1.0.2</InformationalVersion>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GMS.Core\GMS.Core.vbproj" />
  </ItemGroup>

  <!-- Read at request time by the download page so publishing a release is editing this
       file, not redeploying the site. Update, not Include: the Web SDK already globs .json
       as Content, and adding it again is a duplicate-item error. -->
  <ItemGroup>
    <Content Update="releases.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
