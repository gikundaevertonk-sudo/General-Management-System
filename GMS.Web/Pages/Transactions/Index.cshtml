@page
@model GMS.Web.Pages.Transactions.IndexModel
@{ ViewData["Title"] = "Transactions"; Layout = "_Layout"; }

<div class="page-head">
    <h1>Transactions</h1>
    @if (Me.HasPermission(PermissionCodes.Transactions.Create))
    {
        <div class="d-flex gap-2">
            <a asp-page="Edit" asp-route-type="Purchase" class="btn btn-outline-secondary btn-sm">New purchase</a>
            <a asp-page="Edit" asp-route-type="Sale" class="btn btn-primary btn-sm">New sale</a>
        </div>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-6 col-md-3">
        <select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All types</option>
            @foreach (var v in Enum.GetValues<TransactionType>())
            { <option value="@v" selected="@(Model.Type == v)">@v</option> }
        </select>
    </div>
    <div class="col-6 col-md-3">
        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All statuses</option>
            @foreach (var v in Enum.GetValues<TransactionStatus>())
            { <option value="@v" selected="@(Model.Status == v)">@v</option> }
        </select>
    </div>
    <div class="col-12 col-md-4"><input name="q" value="@Model.Q" class="form-control form-control-sm" placeholder="Search number or notes…" /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary btn-sm">Filter</button></div>
</form>

@if (Model.Results is { } r)
{
    <div class="card"><div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead><tr>
                <th>Number</th><th>Date</th><th>Type</th><th>Status</th><th>Party</th>
                <th class="text-end">Total</th><th></th>
            </tr></thead>
            <tbody>
            @foreach (var t in r.Items)
            {
                <tr>
                    <td><a asp-page="Edit" asp-route-id="@t.Id">@t.TransactionNumber</a></td>
                    <td>@t.TransactionDate.ToString("yyyy-MM-dd")</td>
                    <td>@t.Type</td>
                    <td><span class="badge bg-@(t.Status == TransactionStatus.Confirmed ? "success" : t.Status == TransactionStatus.Cancelled ? "secondary" : "warning text-dark")">@t.Status</span></td>
                    <td>@Model.PartyOf(t)</td>
                    <td class="text-end">@t.Total.ToString("N2")</td>
                    <td class="text-end text-nowrap">
                        @if (t.Status == TransactionStatus.Draft && Me.HasPermission(PermissionCodes.Transactions.Confirm))
                        {
                            <form method="post" asp-page-handler="Confirm" asp-route-id="@t.Id" class="d-inline">
                                <button class="btn btn-sm btn-link py-0">Confirm</button>
                            </form>
                        }
                        @if (t.Status != TransactionStatus.Cancelled && Me.HasPermission(PermissionCodes.Transactions.Cancel))
                        {
                            <form method="post" asp-page-handler="Cancel" asp-route-id="@t.Id" class="d-inline"
                                  onsubmit="return confirm('Cancel this transaction?');">
                                <button class="btn btn-sm btn-link text-danger py-0">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (r.Items.Count == 0)
            {
                <tr><td colspan="7" class="muted">No transactions found.</td></tr>
            }
            </tbody>
        </table>
    </div></div>

    <nav class="mt-3 d-flex justify-content-between align-items-center">
        <span class="muted small">Page @r.Page of @Math.Max(1, r.TotalPages) · @r.TotalCount</span>
        <div class="btn-group btn-group-sm">
            <a class="btn btn-outline-secondary @(r.HasPrevious ? "" : "disabled")"
               asp-route-pageNo="@(r.Page - 1)" asp-route-q="@Model.Q" asp-route-type="@Model.Type" asp-route-status="@Model.Status">‹ Prev</a>
            <a class="btn btn-outline-secondary @(r.HasNext ? "" : "disabled")"
               asp-route-pageNo="@(r.Page + 1)" asp-route-q="@Model.Q" asp-route-type="@Model.Type" asp-route-status="@Model.Status">Next ›</a>
        </div>
    </nav>
}
