@page
@model GMS.Web.Pages.Transactions.EditModel
@{
    ViewData["Title"] = Model.Txn is null ? $"New {(Model.Type?.ToString().ToLower())}" : Model.Txn.TransactionNumber;
    Layout = "_Layout";
}

<div class="page-head">
    <h1>@ViewData["Title"] @if (Model.Txn is not null) { <span class="badge bg-secondary align-middle">@Model.Txn.Status</span> }</h1>
    <a asp-page="Index" class="btn btn-link btn-sm">Back to list</a>
</div>

@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }

@if (Model.Txn is null)
{
    <div class="card" style="max-width:560px;"><div class="card-body">
        <form method="post" asp-page-handler="Create" class="row g-3">
            @if (Model.NeedsParty)
            {
                <div class="col-12">
                    <label class="form-label">@(Model.Type == TransactionType.Sale ? "Customer" : "Supplier")</label>
                    <select asp-for="PartyId" asp-items="Model.PartyOptions" class="form-select"></select>
                </div>
            }
            <div class="col-md-6">
                <label asp-for="TxnDate" class="form-label">Date</label>
                <input asp-for="TxnDate" type="date" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label">Notes</label>
                <input asp-for="Notes" class="form-control" />
            </div>
            <div class="col-12"><button class="btn btn-primary">Start transaction</button></div>
        </form>
    </div></div>
}
else
{
    var t = Model.Txn;
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card"><div class="card-header fw-semibold">Lines</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead><tr><th>Product</th><th class="text-end">Qty</th><th class="text-end">Unit</th><th class="text-end">Tax%</th><th class="text-end">Total</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var l in t.Lines)
                    {
                        <tr>
                            <td>@l.Description</td>
                            <td class="text-end">@l.Quantity.ToString("N3")</td>
                            <td class="text-end">@l.UnitPrice.ToString("N2")</td>
                            <td class="text-end">@l.TaxRate.ToString("N2")</td>
                            <td class="text-end">@l.LineTotal.ToString("N2")</td>
                            <td class="text-end">
                                @if (Model.IsDraft)
                                {
                                    <form method="post" asp-page-handler="RemoveLine" asp-route-id="@t.Id" asp-route-lineId="@l.Id" class="d-inline">
                                        <button class="btn btn-sm btn-link text-danger py-0">Remove</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (t.Lines.Count == 0) { <tr><td colspan="6" class="muted">No lines yet.</td></tr> }
                    </tbody>
                    <tfoot>
                        <tr><th colspan="4" class="text-end">Subtotal</th><th class="text-end">@t.Subtotal.ToString("N2")</th><th></th></tr>
                        <tr><th colspan="4" class="text-end">Tax</th><th class="text-end">@t.TaxTotal.ToString("N2")</th><th></th></tr>
                        <tr><th colspan="4" class="text-end">Total</th><th class="text-end">@t.Total.ToString("N2")</th><th></th></tr>
                    </tfoot>
                </table>
            </div></div>

            @if (Model.IsDraft)
            {
                <div class="card mt-3"><div class="card-body">
                    <form method="post" asp-page-handler="AddLine" asp-route-id="@t.Id" class="row g-2 align-items-end">
                        <div class="col-12 col-sm-5">
                            <label class="form-label mb-0 small">Product</label>
                            <select asp-for="LineProductId" asp-items="Model.ProductOptions" class="form-select form-select-sm"></select>
                        </div>
                        <div class="col-4 col-sm-2"><label class="form-label mb-0 small">Qty</label><input asp-for="LineQty" type="number" step="0.001" class="form-control form-control-sm" /></div>
                        <div class="col-4 col-sm-2"><label class="form-label mb-0 small">Unit</label><input asp-for="LineUnitPrice" type="number" step="0.01" placeholder="auto" class="form-control form-control-sm" /></div>
                        <div class="col-4 col-sm-2"><label class="form-label mb-0 small">Tax%</label><input asp-for="LineTaxPercent" type="number" step="0.01" placeholder="auto" class="form-control form-control-sm" /></div>
                        <div class="col-sm-1"><button class="btn btn-sm btn-primary w-100">Add</button></div>
                    </form>
                </div></div>
            }
        </div>

        <div class="col-lg-5">
            <div class="card"><div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-4 muted">Number</dt><dd class="col-8">@t.TransactionNumber</dd>
                    <dt class="col-4 muted">Type</dt><dd class="col-8">@t.Type</dd>
                    <dt class="col-4 muted">Status</dt><dd class="col-8">@t.Status</dd>
                    <dt class="col-4 muted">Date</dt><dd class="col-8">@t.TransactionDate.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-4 muted">Notes</dt><dd class="col-8">@(string.IsNullOrWhiteSpace(t.Notes) ? "—" : t.Notes)</dd>
                </dl>
            </div>
            @if (Model.IsDraft)
            {
                <div class="card-footer d-flex gap-2">
                    @if (Me.HasPermission(PermissionCodes.Transactions.Confirm))
                    {
                        <form method="post" asp-page-handler="Confirm" asp-route-id="@t.Id"
                              onsubmit="return confirm('Confirm and post stock?');">
                            <button class="btn btn-primary btn-sm">Confirm</button>
                        </form>
                    }
                    @if (Me.HasPermission(PermissionCodes.Transactions.Cancel))
                    {
                        <form method="post" asp-page-handler="Cancel" asp-route-id="@t.Id">
                            <button class="btn btn-outline-danger btn-sm">Cancel</button>
                        </form>
                    }
                </div>
            }
            </div>
        </div>
    </div>
}
