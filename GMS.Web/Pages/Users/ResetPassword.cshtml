@page
@model GMS.Web.Pages.Users.ResetPasswordModel
@{ ViewData["Title"] = "Reset password"; Layout = "_Layout"; }

<div class="page-head"><h1>Reset password</h1><a asp-page="Index" class="btn btn-link btn-sm">Back to list</a></div>

@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }

<div class="card" style="max-width:460px;"><div class="card-body">
    <p class="muted">New temporary password for <strong>@Model.UserName</strong>.</p>
    <form method="post" class="row g-3">
        <input type="hidden" asp-for="Id" />
        <div class="col-12">
            <label asp-for="NewPassword" class="form-label">New password</label>
            <input asp-for="NewPassword" type="text" class="form-control" />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <button class="btn btn-primary">Reset</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
