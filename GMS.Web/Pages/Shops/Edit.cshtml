@page
@model GMS.Web.Pages.Shops.EditModel
@{ ViewData["Title"] = Model.IsNew ? "New shop" : "Edit shop"; Layout = "_Layout"; }

<div class="page-head"><h1>@ViewData["Title"]</h1><a asp-page="Index" class="btn btn-link btn-sm">Back to shops</a></div>

@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }

<div class="card" style="max-width:600px;"><div class="card-body">
<form method="post" class="row g-3">
    <input type="hidden" asp-for="Id" />
    <div class="col-md-8"><label asp-for="Input.Name" class="form-label">Name</label><input asp-for="Input.Name" class="form-control" /></div>
    <div class="col-md-4">
        <label asp-for="Input.Code" class="form-label">Code</label>
        <input asp-for="Input.Code" class="form-control" />
        <div class="form-text">Short reference, unique within your organisation.</div>
    </div>
    <div class="col-12"><label asp-for="Input.Address" class="form-label">Address</label><input asp-for="Input.Address" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Input.Phone" class="form-label">Phone</label><input asp-for="Input.Phone" class="form-control" /></div>
    <div class="col-12 form-check ms-2">
        <input asp-for="Input.IsActive" class="form-check-input" />
        <label asp-for="Input.IsActive" class="form-check-label">Open</label>
    </div>
    <div class="col-12">
        <button class="btn btn-primary">Save</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
</div></div>
