<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · GMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <nav class="navbar navbar-expand-md navbar-dark" style="background:#111827;">
        <div class="container-fluid px-3 px-lg-4">
            <a class="navbar-brand fw-semibold" asp-page="/Index">GMS</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"
                    aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Dashboard</a></li>
                        @if (Me.HasPermission(PermissionCodes.Products.View))
                        { <li class="nav-item"><a class="nav-link" asp-page="/Products/Index">Products</a></li> }
                        @if (Me.HasPermission(PermissionCodes.Categories.View))
                        { <li class="nav-item"><a class="nav-link" asp-page="/Categories/Index">Categories</a></li> }
                        @if (Me.HasPermission(PermissionCodes.Customers.View))
                        { <li class="nav-item"><a class="nav-link" asp-page="/Customers/Index">Customers</a></li> }
                        @if (Me.HasPermission(PermissionCodes.Suppliers.View))
                        { <li class="nav-item"><a class="nav-link" asp-page="/Suppliers/Index">Suppliers</a></li> }
                        @if (Me.HasPermission(PermissionCodes.Transactions.View))
                        { <li class="nav-item"><a class="nav-link" asp-page="/Transactions/Index">Transactions</a></li> }
                        @if (Me.HasPermission(PermissionCodes.Inventory.View))
                        { <li class="nav-item"><a class="nav-link" asp-page="/Inventory/Index">Inventory</a></li> }
                        @if (Me.HasPermission(PermissionCodes.Reports.View))
                        { <li class="nav-item"><a class="nav-link" asp-page="/Reports/Index">Reports</a></li> }
                        @if (Me.HasPermission(PermissionCodes.Users.View))
                        { <li class="nav-item"><a class="nav-link" asp-page="/Users/Index">Users</a></li> }
                        @if (Me.HasPermission(PermissionCodes.Audit.View))
                        { <li class="nav-item"><a class="nav-link" asp-page="/Audit/Index">Audit</a></li> }
                        @if (Me.HasPermission(PermissionCodes.Settings.Manage))
                        { <li class="nav-item"><a class="nav-link" asp-page="/Settings/Index">Settings</a></li> }
                    </ul>
                    <ul class="navbar-nav">
                        @{ var unread = MyNotifications.UnreadCountForCurrentUser(); }
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Notifications/Index">
                                Alerts
                                @if (unread > 0) { <span class="badge bg-danger ms-1">@unread</span> }
                            </a>
                        </li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Account/ChangePassword">@User.Identity!.Name</a></li>
                        <li class="nav-item">
                            <form method="post" asp-page="/Account/Logout" class="d-inline">
                                <button type="submit" class="btn btn-link nav-link">Sign out</button>
                            </form>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <main class="container-fluid px-3 px-lg-4 py-4" style="max-width:1200px;">
        @if (TempData["Flash"] is string flash)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @flash
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
