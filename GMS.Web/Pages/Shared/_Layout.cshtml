<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · GMS</title>
    @* Set the theme before the stylesheets are applied, so a dark-mode user
       never sees a white flash. Must stay inline and in the head: an external
       script would load too late. Keep the key and attribute in step with
       wwwroot/js/theme.js. *@
    <script>
        (function () {
            var t;
            try { t = localStorage.getItem('gms-theme'); } catch (e) { t = null; }
            if (!t) {
                t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
@{
    bool IsActive(string path) => path == "/"
        ? Context.Request.Path == "/"
        : Context.Request.Path.StartsWithSegments(path, StringComparison.OrdinalIgnoreCase);
}
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="d-flex" style="min-height:100vh;">
        <div class="topbar d-flex d-md-none align-items-center px-3">
            <button class="btn btn-sm btn-outline-light" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <a class="navbar-brand fw-semibold ms-2" asp-page="/Index">GMS</a>
        </div>

        <nav class="offcanvas-md offcanvas-start sidebar" tabindex="-1" id="sidebar">
            <div class="offcanvas-header d-md-none">
                <h5 class="offcanvas-title sidebar-brand mb-0">GMS</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0">
                <div class="sidebar-brand d-none d-md-block">GMS</div>
                <ul class="nav flex-column sidebar-nav flex-grow-1">
                    <li class="nav-item"><a class="nav-link @(IsActive("/") ? "active" : "")" asp-page="/Index">Dashboard</a></li>
                    @if (Me.HasPermission(PermissionCodes.Products.View))
                    { <li class="nav-item"><a class="nav-link @(IsActive("/Products") ? "active" : "")" asp-page="/Products/Index">Products</a></li> }
                    @if (Me.HasPermission(PermissionCodes.Categories.View))
                    { <li class="nav-item"><a class="nav-link @(IsActive("/Categories") ? "active" : "")" asp-page="/Categories/Index">Categories</a></li> }
                    @if (Me.HasPermission(PermissionCodes.Customers.View))
                    { <li class="nav-item"><a class="nav-link @(IsActive("/Customers") ? "active" : "")" asp-page="/Customers/Index">Customers</a></li> }
                    @if (Me.HasPermission(PermissionCodes.Suppliers.View))
                    { <li class="nav-item"><a class="nav-link @(IsActive("/Suppliers") ? "active" : "")" asp-page="/Suppliers/Index">Suppliers</a></li> }
                    @if (Me.HasPermission(PermissionCodes.Transactions.View))
                    { <li class="nav-item"><a class="nav-link @(IsActive("/Transactions") ? "active" : "")" asp-page="/Transactions/Index">Transactions</a></li> }
                    @if (Me.HasPermission(PermissionCodes.Inventory.View))
                    { <li class="nav-item"><a class="nav-link @(IsActive("/Inventory") ? "active" : "")" asp-page="/Inventory/Index">Inventory</a></li> }
                    @if (Me.HasPermission(PermissionCodes.Reports.View))
                    { <li class="nav-item"><a class="nav-link @(IsActive("/Reports") ? "active" : "")" asp-page="/Reports/Index">Reports</a></li> }
                    @if (Me.HasPermission(PermissionCodes.Users.View))
                    { <li class="nav-item"><a class="nav-link @(IsActive("/Users") ? "active" : "")" asp-page="/Users/Index">Users</a></li> }
                    @if (Me.HasPermission(PermissionCodes.Audit.View))
                    { <li class="nav-item"><a class="nav-link @(IsActive("/Audit") ? "active" : "")" asp-page="/Audit/Index">Audit</a></li> }
                    @if (Me.HasPermission(PermissionCodes.Settings.Manage))
                    { <li class="nav-item"><a class="nav-link @(IsActive("/Settings") ? "active" : "")" asp-page="/Settings/Index">Settings</a></li> }
                </ul>
                <div class="sidebar-footer">
                    @{ var unread = MyNotifications.UnreadCountForCurrentUser(); }
                    <a class="sidebar-link @(IsActive("/Notifications") ? "active" : "")" asp-page="/Notifications/Index">
                        Alerts
                        @if (unread > 0) { <span class="badge bg-danger ms-1">@unread</span> }
                    </a>
                    <div class="sidebar-user">@User.Identity!.Name</div>
                    <button type="button" class="sidebar-link theme-toggle" aria-pressed="false" title="Switch between light and dark">
                        <span class="theme-label-dark">Dark mode</span>
                        <span class="theme-label-light">Light mode</span>
                    </button>
                    <a class="sidebar-link" asp-page="/Account/ChangePassword">Change password</a>
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="sidebar-link btn btn-link p-0">Sign out</button>
                    </form>
                </div>
            </div>
        </nav>

        <main class="flex-fill p-3 p-lg-4 main-content">
            @if (TempData["Flash"] is string flash)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @flash
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
}
else
{
    <div class="topbar d-flex align-items-center px-3">
        <a class="navbar-brand fw-semibold" asp-page="/Index">GMS</a>
        @* Signed-out pages have no sidebar, so the toggle lives here - the login
           page is the first thing a dark-mode user sees. *@
        <button type="button" class="theme-toggle ms-auto" aria-pressed="false" title="Switch between light and dark">
            <span class="theme-label-dark">Dark mode</span>
            <span class="theme-label-light">Light mode</span>
        </button>
    </div>
    <main class="container-fluid px-3 px-lg-4 py-4" style="max-width:1200px;">
        @if (TempData["Flash"] is string flash)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @flash
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
