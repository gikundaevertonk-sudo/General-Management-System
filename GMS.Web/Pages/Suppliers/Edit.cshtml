@page
@model GMS.Web.Pages.Suppliers.EditModel
@{ ViewData["Title"] = Model.IsNew ? "New supplier" : "Edit supplier"; Layout = "_Layout"; }

<div class="page-head"><h1>@ViewData["Title"]</h1><a asp-page="Index" class="btn btn-link btn-sm">Back to list</a></div>

@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }

<div class="card" style="max-width:640px;"><div class="card-body">
<form method="post" class="row g-3">
    <input type="hidden" asp-for="Id" />
    <div class="col-12"><label asp-for="Input.Name" class="form-label">Name</label><input asp-for="Input.Name" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Input.ContactName" class="form-label">Contact name</label><input asp-for="Input.ContactName" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Input.Email" class="form-label">Email</label><input asp-for="Input.Email" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Input.Phone" class="form-label">Phone</label><input asp-for="Input.Phone" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Input.Address" class="form-label">Address</label><input asp-for="Input.Address" class="form-control" /></div>
    <div class="col-12 form-check ms-2">
        <input asp-for="Input.IsActive" class="form-check-input" />
        <label asp-for="Input.IsActive" class="form-check-label">Active</label>
    </div>
    <div class="col-12">
        <button class="btn btn-primary">Save</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
</div></div>
