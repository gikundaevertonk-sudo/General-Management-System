@page
@model GMS.Web.Pages.Customers.IndexModel
@{ ViewData["Title"] = "Customers"; Layout = "_Layout"; }
@{ var canEdit = Me.HasPermission(PermissionCodes.Customers.Edit); }

<div class="page-head">
    <h1>Customers</h1>
    @if (canEdit) { <a asp-page="Edit" class="btn btn-primary btn-sm">New customer</a> }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-sm-6 col-md-4"><input name="q" value="@Model.Q" class="form-control form-control-sm" placeholder="Search name, code or email…" /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary btn-sm">Filter</button></div>
</form>

@if (Model.Results is { } r)
{
    <div class="card"><div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead><tr><th>Code</th><th>Name</th><th>Contact</th><th>Email</th><th>Phone</th><th>Active</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in r.Items)
            {
                <tr>
                    <td>@c.Code</td><td>@c.Name</td><td>@c.ContactName</td><td>@c.Email</td><td>@c.Phone</td>
                    <td>@(c.IsActive ? "Yes" : "No")</td>
                    <td class="text-end text-nowrap">
                        @if (canEdit)
                        {
                            <a asp-page="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-link py-0">Edit</a>
                            <form method="post" asp-page-handler="Toggle" asp-route-id="@c.Id" asp-route-active="@c.IsActive" class="d-inline">
                                <button class="btn btn-sm btn-link py-0">@(c.IsActive ? "Deactivate" : "Activate")</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (r.Items.Count == 0) { <tr><td colspan="7" class="muted">No customers yet.</td></tr> }
            </tbody>
        </table>
    </div></div>

    <nav class="mt-3 d-flex justify-content-between align-items-center">
        <span class="muted small">Page @r.Page of @Math.Max(1, r.TotalPages) · @r.TotalCount</span>
        <div class="btn-group btn-group-sm">
            <a class="btn btn-outline-secondary @(r.HasPrevious ? "" : "disabled")" asp-route-pageNo="@(r.Page - 1)" asp-route-q="@Model.Q">‹ Prev</a>
            <a class="btn btn-outline-secondary @(r.HasNext ? "" : "disabled")" asp-route-pageNo="@(r.Page + 1)" asp-route-q="@Model.Q">Next ›</a>
        </div>
    </nav>
}
