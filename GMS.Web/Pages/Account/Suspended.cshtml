@page
@model GMS.Web.Pages.Account.SuspendedModel
@{
    ViewData["Title"] = "Account Suspended";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-9 col-md-6 col-lg-5">
        <div class="card mt-5">
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <svg class="mb-3" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-danger">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </div>
                <h1 class="h3 mb-3">Account Suspended</h1>
                <p class="text-muted mb-4">Your organization's account has been suspended and is not currently available.</p>

                <div class="alert alert-warning mb-4">
                    <strong>What to do:</strong>
                    <ul class="mb-0 mt-2 text-start">
                        <li>Contact our support team to resolve this issue</li>
                        <li>Email: support@gms.local</li>
                        <li>Phone: +1 (555) 123-4567</li>
                    </ul>
                </div>

                <a href="/Account/Logout" class="btn btn-secondary">Sign out</a>
            </div>
        </div>
    </div>
</div>
