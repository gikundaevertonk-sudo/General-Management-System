@page
@model GMS.Web.Pages.Account.TrialExpiredModel
@{
    ViewData["Title"] = "Trial Expired";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-9 col-md-6 col-lg-5">
        <div class="card mt-5">
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <svg class="mb-3" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-warning">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
                <h1 class="h3 mb-3">Trial Period Expired</h1>
                <p class="text-muted mb-4">Your organization's trial period has ended. To continue using General Management System, please upgrade to a paid plan.</p>

                <div class="alert alert-info mb-4">
                    <strong>Next Steps:</strong>
                    <ul class="mb-0 mt-2 text-start">
                        <li>Contact our sales team to upgrade your subscription</li>
                        <li>Email: sales@gms.local</li>
                        <li>We offer monthly and annual billing options</li>
                    </ul>
                </div>

                <a href="/Account/Logout" class="btn btn-secondary">Sign out</a>
            </div>
        </div>
    </div>
</div>
