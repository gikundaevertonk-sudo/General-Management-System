{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"

  // Platform:Operator:UserName and Platform:Operator:PasswordHash are deliberately absent.
  // Supply them through user-secrets or the environment; when either is missing the console
  // refuses every sign-in and the login page returns 404, so an unconfigured deployment
  // exposes no operator surface at all. ConnectionStrings:Gms is supplied the same way.
}
